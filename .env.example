# TEMPLATE ONLY - this file is tracked by Git. NEVER put a real key here.
# Copy it to .env (git-ignored) and put YOUR key in .env.
# Every offline workflow (tests, --dry-run, evaluator, API mock mode, UI) works without a key.
ANTHROPIC_API_KEY=your_key_here
HWSETS_MODEL=claude-sonnet-5-5

# Optional
# ANTHROPIC_WORKSPACE_ID=           # only if your key is not scoped to a workspace (API error: 'must include the anthropic-workspace-id header')
# HWSETS_MOCK=1                      # API dev mode: use the mock extractor (NOT real extraction)
# HWSETS_OUTPUT_DIR=outputs          # dry-run files and stored API results
# HWSETS_API=http://localhost:8000   # where the Streamlit UI finds the API
